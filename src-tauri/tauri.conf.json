{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ARGON",
  "mainBinaryName": "ARGON",
  "version": "2.2.0",
  "identifier": "com.otium.downloader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run prepare:tools && npm run dev",
    "beforeBuildCommand": "npm run prepare:tools && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ARGON",
        "url": "index.html",
        "width": 1180,
        "height": 820,
        "minWidth": 360,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' https://tauri.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost https://tauri.localhost https://api.github.com https://github.com https://raw.githubusercontent.com",
        "font-src": "'self' data: https://tauri.localhost",
        "img-src": "'self' data: blob: https://tauri.localhost",
        "media-src": "'self' blob: data: https://tauri.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "worker-src": "'self' blob:",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "allowDowngrades": false
    },
    "createUpdaterArtifacts": true,
    "resources": {
      "../browser-extension/": "browser-extension/",
      "tools/": "tools/"
    }
  },
  "plugins": {
    "opener": {},
    "updater": {
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/XRTM8/ARGON/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0MjQ2RTRENjMyMDE4RUMKUldUc0dDQmpUVzRrWkNnc3J5VS9mVTFIdVlMMVpUU2hUZWRlSHRaRE5BVnJoeG13aCtkUGNtOHEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
